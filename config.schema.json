                  "8",
                  "9",
                  "12",
                  "#",
                  "Clear / Cancel"
                ]
              }
            }
          }
        }
      }
    }
  },
  "layout": [
    "name",
    "host",
    "pollInterval",
    "debug",
    {
      "type": "fieldset",
      "title": "State Sensors",
      "expandable": true,
      "expanded": true,
      "items": [
        "sensors.playing",
        "sensors.power",
        "sensors.active"
      ]
    },
    {
      "type": "fieldset",
      "title": "Command Groups",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "key": "groups",
          "notitle": true,
          "type": "array",
          "items": [
            {
              "type": "fieldset",
              "items": [
                "groups[].name",
                {
                  "key": "groups[].commands",
                  "type": "checkboxes"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
